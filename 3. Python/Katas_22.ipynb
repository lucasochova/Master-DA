    "\"\"\" \n",
    "Dada una lista numérica, obtén el producto total de los valores de dicha lista.Usa la función  reduce()\n",
    "\"\"\"\n",
    "from functools import reduce\n",
    "lista_numeros=[1,2,3,4,5]\n",
    "\n",
    "producto=reduce(lambda x,y:x*y,lista_numeros)\n",
    "producto"
   ]
